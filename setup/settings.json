  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: personal developer. Primary use: software development (Kotlin/Ktor, Python/FastAPI, React) on Windows and macOS",
      "Source control: github.com/<your-github-user> and all repositories under it",
      "Secrets management: Phase (phase.dev). Secrets are injected via `phase run` or local .env files and are never committed",
      "CI/CD deploy targets: Dokploy on a self-hosted VPS behind Traefik and Cloudflare DNS; Dokploy deploys from git pushes",
      "Trusted web-research fetcher: the user's own self-hosted Scrapling MCP server (tools mcp__scrapling__*), used to read public web pages that block normal fetches",
      "Sensitive remote targets: the production VPS (any ssh/scp/rsync target) and any MongoDB instance not running on localhost or in a local Docker container",
      "Documentation lookup: Context7 (mcp.context7.com, Upstash) is a trusted docs service; sending library names and documentation questions there is expected. Never send source code, secrets or personal data",
      "Local browser debugging: the chrome-devtools MCP drives a local Chrome against localhost dev servers and URLs the user named",
      "Databases: the MongoDB MCP runs read-only (MDB_MCP_READ_ONLY=true) and is meant for localhost or local Docker MongoDB instances only"
    ]
  },
  "switchModelsOnFlag": true
}
