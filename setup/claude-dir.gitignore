# Ignore everything — ~/.claude holds credentials, history, caches
*

# Re-include only what should sync
!.gitignore
!.gitattributes
!README.md
!CHANGELOG.md
!settings.json
!CLAUDE.md
!scripts/
!scripts/**
!rules/
!rules/**

!agents/
!agents/**
!commands/
!commands/**
!skills/
!skills/**
skills/synced/
skills/.trash/
!hooks/
!hooks/**
!.github/
!.github/**
!.claude-plugin/
!.claude-plugin/**
!mods/
!mods/**
mods/**/.claude-plugin/types/

!paseo/
!paseo/**
paseo/**/node_modules/
!docker/
!docker/**
!templates/
!templates/**
!docs/
!docs/**

# Never track real env files, also inside the whitelisted directories above.
.env
.env.*
!.env.example
