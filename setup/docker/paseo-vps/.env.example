# Paseo VPS container. Put the real values into the Dokploy environment tab
# (source: OpenBao). Never commit a real .env file.

# GitHub fine-grained token for gh and HTTPS git. Selected repositories only.
# Permissions: Contents read/write, Pull requests read/write, Metadata read.
# Add Issues read/write if agents should create, edit or comment on issues.
# Exclude the config sync repository. Protect each project's default branch.
# No Administration, no Workflows, no Secrets.
GH_TOKEN=

# Separate fine-grained token for the config sync repository only.
# Permissions: Contents read, Metadata read. Every agent can read both tokens.
CLAUDE_CONFIG_READ_TOKEN=
CLAUDE_CONFIG_BRANCH=master

# ntfy alerts from the quota-guard plugin. The token goes only to NTFY_URL.
NTFY_URL=https://ntfy.example.com
NTFY_TOKEN=

# agy executable for the quota-guard usage checks. The image puts agy on PATH.
AGY_COMMAND=agy

TZ=Europe/Berlin

# Resource limits for the whole container (daemon plus all agents).
PASEO_MEM_LIMIT=6g
PASEO_CPUS=3
